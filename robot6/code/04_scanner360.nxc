// Introduction - FINAL TASK: Environment scanner
//  1. turn 360 degrees in 12 steps of 30 degrees, measure distance each step
//  2. save the data into scan.txt
//  3. draw the data on the screen (like a radar)
//  4. turn to the most free direction (largest distance) and drive there
//  5. stop when the color sensor sees a RED spot

#include "robot_config.h"
#define STEPS 12
#define STEP_ANGLE 30

int dist[STEPS];

task main()
{
  byte fh;
  unsigned int cnt;
  int i, best = 0;

  SetSensorLowspeed(SONAR);
  SetSensorColorFull(COLOR);
  ClearScreen();
  TextOut(0, LCD_LINE1, "Scanning...");

  DeleteFile("scan.txt");
  CreateFile("scan.txt", 1024, fh);

  // 1 + 2: scan and save
  for (i = 0; i < STEPS; i++) {
    Wait(200);                         // let the sonar settle
    dist[i] = SensorUS(SONAR);         // 255 = nothing seen
    string s = NumToStr(i * STEP_ANGLE) + " deg: " + NumToStr(dist[i]) + " cm";
    WriteLnString(fh, s, cnt);
    if (dist[i] > dist[best]) best = i;
    TurnRight(STEP_ANGLE);
  }
  CloseFile(fh);

  // 3: draw a radar picture. Robot = middle, line length = distance
  ClearScreen();
  CircleOut(32, 32, 2);
  for (i = 0; i < STEPS; i++) {
    int r = dist[i] * 30 / 100;        // 100 cm or more = full length (30 px)
    if (r > 30) r = 30;
    int a = i * STEP_ANGLE;
    int x = 32 + r * Sin(a) / 100;     // Sin/Cos give value * 100
    int y = 32 + r * Cos(a) / 100;
    LineOut(32, 32, x, y);
  }
  TextOut(66, LCD_LINE1, "BEST:");
  NumOut(66, LCD_LINE2, best * STEP_ANGLE);
  TextOut(66, LCD_LINE4, "dist:");
  NumOut(66, LCD_LINE5, dist[best]);
  Wait(4000);

  // 4: turn to the best direction (robot is back at 0 deg after 360)
  TurnRight(best * STEP_ANGLE);
  Forward(40);

  // 5: drive until red spot (or something is too close, for safety)
  until(Sensor(COLOR) == INPUT_REDCOLOR || SensorUS(SONAR) < 15);
  Off(BOTH);
  PlayTone(880, 300);
  TextOut(66, LCD_LINE7, "STOP");
  Wait(10000);
}
