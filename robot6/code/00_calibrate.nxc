// Calibration - run this after 01_port_check.
// 1) Robot drives 50 cm forward. Measure with a ruler.
//    If it went e.g. 45 cm instead of 50:  WHEEL_D = WHEEL_D * 45 / 50
// 2) Robot turns RIGHT 4 x 90 degrees (= one full circle).
//    Turned too little -> make TURN_FACTOR bigger, too much -> smaller.
//    If it turned LEFT, swap 100 and -100 in TurnRight/TurnLeft (robot_config.h).
// Write the corrected numbers into robot_config.h.

#include "robot_config.h"

task main()
{
  ClearScreen();
  TextOut(0, LCD_LINE1, "CALIBRATION");
  TextOut(0, LCD_LINE3, "ENTER = 50cm");
  WaitEnter();
  Move(50);

  TextOut(0, LCD_LINE3, "ENTER = turn 360");
  WaitEnter();
  for (int i = 0; i < 4; i++) {
    TurnRight(90);
    Wait(300);
  }
  TextOut(0, LCD_LINE5, "Done");
  Wait(3000);
}
